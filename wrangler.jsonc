{
  "name": "beppe-barber",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist"
  },
  "build": {
    "command": "sh build.sh"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "beppebarber.com",
      "custom_domain": true
    },
    {
      "pattern": "www.beppebarber.com",
      "custom_domain": true
    }
  ]
}
